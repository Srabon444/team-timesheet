{
  "manifest_version": 3,
  "name": "Daily Timesheet Auto-Filler",
  "version": "1.0.0",
  "description": "Per-project timers that auto-fill your team's Fillout daily timesheet form. Optional Google Drive backup. Unofficial.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "scripting",
    "alarms",
    "notifications",
    "identity"
  ],
  "host_permissions": [
    "https://techzu.fillout.com/*",
    "https://www.googleapis.com/*",
    "https://oauth2.googleapis.com/*",
    "https://api.aladhan.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Daily Timesheet",
    "default_icon": {
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "128": "icons/icon128.png"
  },
  "oauth2": {
    "client_id": "789173524951-io688vg8m1geo34nqipg9u19jl1rcb5i.apps.googleusercontent.com",
    "scopes": [
      "https://www.googleapis.com/auth/drive.file"
    ]
  },
  "key": ""
}
